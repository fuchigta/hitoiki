{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hitoiki",
  "version": "0.2.0",
  "identifier": "dev.hitoiki.app",
  "mainBinaryName": "hitoiki-app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Hitoiki",
        "width": 1080,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "windows/hitoiki-path.ps1": "hitoiki-path.ps1"
    },
    "publisher": "fuchigta",
    "shortDescription": "Hitoiki - 個人用の自己管理ツール",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
